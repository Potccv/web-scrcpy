#!/usr/bin/env node
/**
 * test/mock-adb — 模拟 adb 与安卓设备,用于端到端冒烟测试。
 *
 * 行为:
 *   - version / devices / push / reverse(--remove) / getprop 直接成功
 *   - reverse localabstract:NAME tcp:PORT:稍后向 127.0.0.1:PORT 建立两条连接
 *     (第 1 条 = video,发送设备名 + H.264 码流;第 2 条 = control,回声到文件)
 *   - shell app_process ...:打印日志并保持运行(不退出)
 */
import net from "node:net";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const RECORD_FILE = path.join(os.tmpdir(), "wsscrcpy-mock-control.bin");
const TUNNEL_FILE = path.join(os.tmpdir(), "wsscrcpy-mock-tunnel.json");

// 合成 H.264 SPS(1280x720 baseline 3.1)
function makeSps() {
  const bits = [];
  const w = (v, n) => {
    for (let i = n - 1; i >= 0; i--) bits.push((v >> i) & 1);
  };
  const ue = (v) => {
    const cn = v + 1;
    const z = 31 - Math.clz32(cn);
    w(0, z);
    w(1, 1);
    w(cn - (1 << z), z);
  };
  w(0x67, 8); // NAL 头
  w(0x42, 8); // profile baseline
  w(0x00, 8); // constraint
  w(0x1f, 8); // level 3.1
  ue(0);
  ue(0);
  ue(0);
  ue(0);
  ue(1);
  w(0, 1);
  ue(79); // 1280/16-1
  ue(44); // 720/16-1
  w(1, 1);
  w(1, 1);
  w(0, 1);
  w(0, 1);
  while (bits.length % 8) bits.push(0);
  const out = new Uint8Array(bits.length / 8);
  for (let i = 0; i < bits.length; i++) if (bits[i]) out[i >> 3] |= 1 << (7 - (i & 7));
  return out;
}

const SPS = makeSps();
const PPS = new Uint8Array([0x68, 0xce, 0x3c, 0x80]);

function frameHeader(ptsFlags, size) {
  const h = Buffer.alloc(12);
  h.writeBigUInt64BE(ptsFlags, 0);
  h.writeUInt32BE(size, 8);
  return h;
}

function startMockDevice(port) {
  setTimeout(() => {
    // 第 1 条连接 = video
    const video = net.connect(port, "127.0.0.1", () => {
      const name = Buffer.alloc(64);
      name.write("MockDevice", "utf8");
      video.write(name);
      const config = Buffer.concat([SPS, Buffer.from([0, 0, 1]), PPS]);
      const idr = Buffer.from([0x65, 0x88, 0x84, 0x00, 0x01, 0x23, 0x45, 0x67]);
      const delta = Buffer.from([0x41, 0x9a, 0x22, 0x02, 0x03, 0x04]);
      video.write(Buffer.from("h264", "ascii"));
      video.write(Buffer.concat([Buffer.from([0x80, 0, 0, 0]), Buffer.from([0, 0, 5, 0]), Buffer.from([0, 0, 2, 0xd0])])); // session 1280x720
      video.write(Buffer.concat([frameHeader(1n << 62n, config.length), config])); // config
      video.write(Buffer.concat([frameHeader(1n << 61n, idr.length), idr])); // keyframe
      video.write(Buffer.concat([frameHeader(0n, delta.length), delta]));
      video.write(Buffer.concat([frameHeader(0n, delta.length), delta]));
      setInterval(() => {
        if (!video.destroyed) {
          video.write(Buffer.concat([frameHeader(0n, delta.length), delta]));
        }
      }, 1000);
    });
    video.on("error", () => {});

    // 仅视频 + 控制两条连接(音频已移除)
    // 第 3 条连接 = control
    const control = net.connect(port, "127.0.0.1", () => {
      control.on("data", (d) => {
        fs.appendFileSync(RECORD_FILE, d);
        // 回应一条 CLIPBOARD 设备消息([type=0][len][text])
        const text = Buffer.from("mock-clipboard", "utf8");
        const msg = Buffer.alloc(1 + 4 + text.length);
        msg.writeUInt32BE(text.length, 1);
        msg.set(text, 5);
        control.write(msg);
      });
    });
    control.on("error", () => {});
  }, 500);
}

function main() {
  const args = process.argv.slice(2);

  if (args[0] === "version") {
    process.stdout.write("Android Debug Bridge version 1.0.41\n");
    process.exit(0);
  }
  if (args[0] === "devices" && args[1] === "-l") {
    process.stdout.write(
      "List of devices attached\nemulator-5554          device product:sdk_gphone model:Pixel_5 device:redfin transport_id:1\n"
    );
    process.exit(0);
  }
  if (args[0] === "-s") {
    const sub = args[2];
    if (sub === "push") {
      process.exit(0);
    }
    if (sub === "reverse") {
      if (args[3] === "--remove") {
        fs.rmSync(TUNNEL_FILE, { force: true });
        process.exit(0);
      }
      const local = args[3]; // localabstract:NAME
      const port = Number(args[4].replace("tcp:", ""));
      if (local.startsWith("localabstract:") && port) {
        // 真实 adb reverse 注册后立即返回;端口记录到文件,由 app_process 使用
        fs.writeFileSync(TUNNEL_FILE, JSON.stringify({ port }));
      }
      process.exit(0);
    }
    if (sub === "shell") {
      // 模拟 wm size
      if (args.includes("wm") && args.includes("size")) {
        process.stdout.write("Physical size: 1080x2400\n");
        process.exit(0);
      }
      // 模拟 dumpsys input 方向
      if (args.includes("dumpsys") && args.includes("input")) {
        process.stdout.write("SurfaceOrientation: 0\n");
        process.exit(0);
      }
      // 模拟 scrcpy --list-encoders:列出设备支持的编码器后退出
      if (args.includes("list_encoders=true")) {
        process.stdout.write(
          [
            "List of video encoders:",
            "--video-codec=h264 --video-encoder=c2.mock.avc.encoder (hw)",
            "--video-codec=h265 --video-encoder=c2.mock.hevc.encoder (hw)",
            "--video-codec=vp8 --video-encoder=c2.android.vp8.encoder (sw)",
            "--video-codec=vp9 --video-encoder=OMX.google.vp9.encoder (hybrid)",
            "",
          ].join("\n")
        );
        process.exit(0);
      }
      // 打印一些服务器日志并保持存活(模拟 app_process 常驻)
      process.stdout.write("INFO: Device: [Mock] Pixel 5 (Android 14)\n");
      process.stdout.write("INFO: server started\n");
      // 等待 reverse 注册(最长 3 秒),然后建立设备端连接(video + control,无音频)
      const tryConnect = () => {
        try {
          const data = JSON.parse(fs.readFileSync(TUNNEL_FILE, "utf8"));
          fs.rmSync(TUNNEL_FILE, { force: true });
          startMockDevice(data.port);
        } catch {
          setTimeout(tryConnect, 100);
        }
      };
      tryConnect();
      setInterval(() => {}, 1000);
      return;
    }
    if (sub === "getprop") {
      process.stdout.write("unknown\n");
      process.exit(0);
    }
    if (sub === "connect" || sub === "disconnect") {
      process.stdout.write("connected to 127.0.0.1:5555\n");
      process.exit(0);
    }
  }
  process.exit(0);
}

main();
